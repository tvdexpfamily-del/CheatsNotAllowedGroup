-- === ФУНКЦИЯ ПОИСКА БЛИЖАЙШЕГО ИГРОКА ===
local function findClosestPlayer()
	local myCharacter = localPlayer.Character
	if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end

	local closestPlayer = nil
	local minDistance = math.huge

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			
			if targetRoot and humanoid and humanoid.Health > 0 then
				local distance = (targetRoot.Position - myCharacter.HumanoidRootPart.Position).Magnitude
				if distance < minDistance then
					minDistance = distance
					closestPlayer = player
				end
			end
		end
	end
	return closestPlayer
end

-- === ОБРАБОТКА НАЖАТИЙ (Toggle) ===
lockButton.MouseButton1Click:Connect(function()
	if isLocked then
		isLocked = false
		targetPlayer = nil
		camera.CameraType = Enum.CameraType.Custom
		lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockButton.Text = "OFF"
	else
		targetPlayer = findClosestPlayer()
		if targetPlayer then
			isLocked = true
			camera.CameraType = Enum.CameraType.Scriptable
			lockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			lockButton.Text = "ON"
		end
	end
end)

-- === ОБРАБОТКА СМЕРТИ ИГРОКА (Сброс при смерти) ===
local function onCharacterAdded(character)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.Died:Connect(function()
		if isLocked then
			isLocked = false
			targetPlayer = nil
			camera.CameraType = Enum.CameraType.Custom
			lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			lockButton.Text = "OFF"
		end
	end)
end

if localPlayer.Character then
	onCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(onCharacterAdded)

-- === ЦИКЛ ОБНОВЛЕНИЯ КАМЕРЫ (Как в первом скрипте) ===
RunService.RenderStepped:Connect(function()
	if not isLocked or not targetPlayer then return end

	local targetCharacter = targetPlayer.Character
	-- 1. Проверка: цель вышла из игры или персонаж удален
	if not targetCharacter then
		isLocked = false
		targetPlayer = nil
		camera.CameraType = Enum.CameraType.Custom
		lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockButton.Text = "OFF"
		return
	end

	local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	-- 2. Проверка: цель умерла
	if not targetHumanoid or targetHumanoid.Health <= 0 then
		isLocked = false
		targetPlayer = nil
		camera.CameraType = Enum.CameraType.Custom
		lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockButton.Text = "OFF"
		return
	end

	local targetPos = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
	
	if targetPos then
		-- КЛЮЧЕВОЕ ИСПРАВЛЕНИЕ: Мы не меняем позицию камеры, мы только поворачиваем её!
		-- Это идеально работает и в FPS, и в TPS, сохраняя родное расстояние камеры.
		local currentCamPos = camera.CFrame.Position
		camera.CFrame = CFrame.lookAt(currentCamPos, targetPos.Position)
	end
end)
