local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- === КОНФИГУРАЦИЯ ===
local CONFIG = {
	IS_FPS_MODE = false, -- ПОСТАВЬ true, если тестируешь в шутере от первого лица
	TPS_OFFSET = Vector3.new(0, 5, 15), -- Смещение для 3-го лица (X, Y вверх, Z назад)
	FPS_OFFSET = Vector3.new(0, 0, 0)   -- Смещение для 1-го лица (прямо в голове)
}

local isLocked = false
local targetPlayer = nil

-- === СОЗДАНИЕ UI (С максимальным приоритетом отображения) ===
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LockOnGui"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 99999 -- КРИТИЧЕСКИ ВАЖНО: Делает GUI поверх всех остальных
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local lockButton = Instance.new("TextButton")
lockButton.Name = "LockButton"
lockButton.Size = UDim2.new(0, 64, 0, 64)
lockButton.Position = UDim2.new(0, 20, 0.5, -32)
lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
lockButton.BorderSizePixel = 0
lockButton.Text = "OFF"
lockButton.TextColor3 = Color3.fromRGB(255, 255, 255)
lockButton.Font = Enum.Font.GothamBold
lockButton.TextSize = 16
lockButton.ZIndex = 100 -- Дополнительная защита Z-индекса для самой кнопки
lockButton.Parent = screenGui

local crosshairIcon = Instance.new("ImageLabel")
crosshairIcon.Size = UDim2.new(0.8, 0, 0.8, 0)
crosshairIcon.Position = UDim2.new(0.1, 0, 0.1, 0)
crosshairIcon.BackgroundTransparency = 1
crosshairIcon.Image = "rbxasset://textures/ui/GameBasic/Circle.png"
crosshairIcon.ImageColor3 = Color3.fromRGB(255, 50, 50)
crosshairIcon.ZIndex = 101
crosshairIcon.Parent = lockButton

-- === ФУНКЦИЯ ПОИСКА БЛИЖАЙШЕГО ИГРОКА ===
local function findClosestPlayer()
	local myCharacter = localPlayer.Character
	if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end

	local closestPlayer = nil
	local minDistance = math.huge

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			
			if targetRoot and humanoid and humanoid.Health > 0 then
				local distance = (targetRoot.Position - myCharacter.HumanoidRootPart.Position).Magnitude
				if distance < minDistance then
					minDistance = distance
					closestPlayer = player
				end
			end
		end
	end
	return closestPlayer
end

-- === ОБРАБОТКА НАЖАТИЙ ===
lockButton.MouseButton1Click:Connect(function()
	if isLocked then
		isLocked = false
		targetPlayer = nil
		camera.CameraType = Enum.CameraType.Custom
		lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lockButton.Text = "OFF"
	else
		targetPlayer = findClosestPlayer()
		if targetPlayer then
			isLocked = true
			camera.CameraType = Enum.CameraType.Scriptable
			lockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			lockButton.Text = "ON"
		end
	end
end)

-- === ЦИКЛ ОБНОВЛЕНИЯ КАМЕРЫ ===
RunService.RenderStepped:Connect(function()
	local myCharacter = localPlayer.Character
	if not myCharacter then return end
	
	local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
	local myHead = myCharacter:FindFirstChild("Head") or myRoot -- Для FPS берем голову
	if not myRoot then return end

	if isLocked and targetPlayer then
		local targetCharacter = targetPlayer.Character
		if targetCharacter then
			local targetHead = targetCharacter:FindFirstChild("Head")
			local targetRoot = targetCharacter:FindFirstChild("HumanoidRootPart")
			local targetPos = targetHead or targetRoot
			
			if targetPos then
				-- Выбираем базовую часть и смещение в зависимости от режима
				local basePart = CONFIG.IS_FPS_MODE and myHead or myRoot
				local offset = CONFIG.IS_FPS_MODE and CONFIG.FPS_OFFSET or CONFIG.TPS_OFFSET
				
				local desiredCameraPos = basePart.Position + basePart.CFrame:VectorToWorldSpace(offset)
				
				-- Защита от камеры под землей (для FPS порог ниже)
				local minY = CONFIG.IS_FPS_MODE and 1.5 or 3
				if desiredCameraPos.Y < minY then
					desiredCameraPos = Vector3.new(desiredCameraPos.X, minY, desiredCameraPos.Z)
				end
				
				-- Применяем поворот камеры на цель
				camera.CFrame = CFrame.lookAt(desiredCameraPos, targetPos.Position)
			end
		else
			isLocked = false
			targetPlayer = nil
			camera.CameraType = Enum.CameraType.Custom
			lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			lockButton.Text = "OFF"
		end
	end
end)
