local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local camera = workspace.CurrentCamera

local isLocked = false
local targetPlayer = nil
local cameraOffset = nil -- Смещение камеры относительно головы (запоминается при активации)

-- === СОЗДАНИЕ UI ===
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LockOnGui"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 99999
screenGui.Parent = localPlayer:WaitForChild("PlayerGui")

local lockButton = Instance.new("TextButton")
lockButton.Name = "LockButton"
lockButton.Size = UDim2.new(0, 64, 0, 64)
lockButton.Position = UDim2.new(0, 20, 0.5, -32)
lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
lockButton.BorderSizePixel = 0
lockButton.Text = "OFF"
lockButton.TextColor3 = Color3.fromRGB(255, 255, 255)
lockButton.Font = Enum.Font.GothamBold
lockButton.TextSize = 16
lockButton.ZIndex = 100
lockButton.Parent = screenGui

local crosshairIcon = Instance.new("ImageLabel")
crosshairIcon.Size = UDim2.new(0.8, 0, 0.8, 0)
crosshairIcon.Position = UDim2.new(0.1, 0, 0.1, 0)
crosshairIcon.BackgroundTransparency = 1
crosshairIcon.Image = "rbxasset://textures/ui/GameBasic/Circle.png"
crosshairIcon.ImageColor3 = Color3.fromRGB(255, 50, 50)
crosshairIcon.ZIndex = 101
crosshairIcon.Parent = lockButton

-- === СБРОС СОСТОЯНИЯ (используется в нескольких местах) ===
local function resetLock()
	isLocked = false
	targetPlayer = nil
	cameraOffset = nil
	camera.CameraType = Enum.CameraType.Custom
	lockButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	lockButton.Text = "OFF"
end

-- === ФУНКЦИЯ ПОИСКА БЛИЖАЙШЕГО ИГРОКА ===
local function findClosestPlayer()
	local myCharacter = localPlayer.Character
	if not myCharacter or not myCharacter:FindFirstChild("HumanoidRootPart") then return nil end

	local closestPlayer = nil
	local minDistance = math.huge

	for _, player in pairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Character then
			local targetRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			
			if targetRoot and humanoid and humanoid.Health > 0 then
				local distance = (targetRoot.Position - myCharacter.HumanoidRootPart.Position).Magnitude
				if distance < minDistance then
					minDistance = distance
					closestPlayer = player
				end
			end
		end
	end
	return closestPlayer
end

-- === ОБРАБОТКА НАЖАТИЙ ===
lockButton.MouseButton1Click:Connect(function()
	if isLocked then
		resetLock()
	else
		targetPlayer = findClosestPlayer()
		if targetPlayer then
			isLocked = true
			camera.CameraType = Enum.CameraType.Scriptable
			
			-- КЛЮЧЕВОЙ МОМЕНТ: Запоминаем где камера сейчас относительно головы
			-- Это работает в ЛЮБОМ режиме (FPS, TPS, кастомный)
			local myCharacter = localPlayer.Character
			if myCharacter then
				local myHead = myCharacter:FindFirstChild("Head") or myCharacter:FindFirstChild("HumanoidRootPart")
				if myHead then
					-- PointToObjectSpace конвертирует мировую позицию камеры
					-- в локальные координаты головы (X=влево/вправо, Y=вверх/вниз, Z=вперёд/назад)
					cameraOffset = myHead.CFrame:PointToObjectSpace(camera.CFrame.Position)
				end
			end
			
			lockButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
			lockButton.Text = "ON"
		end
	end
end)

-- === СБРОС ПРИ СМЕРТИ ИГРОКА ===
local function onCharacterAdded(character)
	-- Сбрасываем при каждом респавне
	resetLock()
	
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.Died:Connect(function()
		resetLock()
	end)
end

if localPlayer.Character then
	onCharacterAdded(localPlayer.Character)
end
localPlayer.CharacterAdded:Connect(onCharacterAdded)

-- === ЦИКЛ ОБНОВЛЕНИЯ КАМЕРЫ ===
RunService.RenderStepped:Connect(function()
	if not isLocked or not targetPlayer or not cameraOffset then return end

	-- Проверка нашего персонажа
	local myCharacter = localPlayer.Character
	if not myCharacter then resetLock() return end
	local myHead = myCharacter:FindFirstChild("Head") or myCharacter:FindFirstChild("HumanoidRootPart")
	if not myHead then resetLock() return end

	-- Проверка цели
	local targetCharacter = targetPlayer.Character
	if not targetCharacter then resetLock() return end

	local targetHumanoid = targetCharacter:FindFirstChildOfClass("Humanoid")
	if not targetHumanoid or targetHumanoid.Health <= 0 then resetLock() return end

	local targetPos = targetCharacter:FindFirstChild("Head") or targetCharacter:FindFirstChild("HumanoidRootPart")
	if not targetPos then return end

	-- Вычисляем новую позицию камеры:
	-- Берём текущую позицию головы и добавляем запомненное смещение
	-- PointToWorldSpace — обратная операция к PointToObjectSpace
	local desiredCameraPos = myHead.CFrame:PointToWorldSpace(cameraOffset)

	-- Защита от камеры под землёй
	if desiredCameraPos.Y < 2 then
		desiredCameraPos = Vector3.new(desiredCameraPos.X, 2, desiredCameraPos.Z)
	end

	-- Поворачиваем камеру на цель
	camera.CFrame = CFrame.lookAt(desiredCameraPos, targetPos.Position)
end)
